{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,

    "target": "ES2021",

    "sourceMap": true,

    "outDir": "./dist",

    "incremental": true,

    "skipLibCheck": true,

    "moduleResolution": "node",
    "baseUrl": "./",

    "paths": {
      "*": ["node_modules/*"]
    }
  }
}
